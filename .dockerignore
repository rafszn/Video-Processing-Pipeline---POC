# Dependencies — always installed fresh inside the image. Never copy host
# node_modules in: native modules (sharp, ioredis) are platform-specific,
# and this keeps the build context small.
node_modules
**/node_modules

# Build output — regenerated inside the image by `npm run build`.
dist
**/dist
*.tsbuildinfo
**/*.tsbuildinfo

# VCS / editor
.git
.gitignore
.idea
.DS_Store

# Env files — real secrets are injected via docker-compose `environment:`,
# never baked into an image.
.env
.env.*
!.env.example

# Logs / misc
*.log
npm-debug.log*
coverage
tests
