{
  "compilerOptions": {
    "strict": true,
    "allowJs": false,
    "types": ["node"],
    "target": "ES2022",
    "module": "NodeNext",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "moduleResolution": "NodeNext",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": false,
    "forceConsistentCasingInFileNames": true,

    /* Added for monorepo support */
    "composite": true,
    "declaration": true
  }
}
